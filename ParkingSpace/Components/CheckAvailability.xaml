<UserControl x:Class="ParkingSpace.Components.CheckAvailability"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:ParkingSpace.Components" 
             mc:Ignorable="d" 
             xmlns:fa="clr-namespace:FontAwesome.WPF;assembly=FontAwesome.WPF"
             d:DesignHeight="850" d:DesignWidth="800">
    <Grid Background="#F0F4F8">
        <!-- Top Bar -->
        <Border Background="#263B47" Height="60" VerticalAlignment="Top">
            <DockPanel VerticalAlignment="Center" Margin="0,-10,0,0">
                <fa:ImageAwesome Icon="Search" Width="30" Height="30"
                             Foreground="White" Margin="10,0" />
                <TextBlock Text="Check Availability" Foreground="White" FontSize="22" 
                       FontWeight="Bold" VerticalAlignment="Center" 
                       Margin="5,0" />
            </DockPanel>
        </Border>

        <!-- Main Content -->
        <StackPanel Margin="10,70,10,10">
            <!-- Filters Section -->
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,10">
                <!-- SpotLocation Filter -->
                <StackPanel>
                    <Label Content="Spot Location" HorizontalAlignment="Center"/>
                    <TextBox Name="SpotLocationFilter"
                           Width="150" Margin="5" />
                </StackPanel>

                <!-- Section Filter -->
                <StackPanel>
                    <Label Content="Section" HorizontalAlignment="Center"/>
                    <ComboBox Name="SectionFilter" Width="150" Margin="5"/>
                </StackPanel>

                <!-- Level Filter -->
                <StackPanel>
                    <Label Content="Level" HorizontalAlignment="Center"/>
                    <ComboBox Name="LevelFilter" Width="150" Margin="5"/>
                </StackPanel>



            </StackPanel>

            <!-- DataGrid -->
            <DataGrid Height="400" Name="ParkingStatusDatagrid" AutoGenerateColumns="False"
                      HorizontalAlignment="Center" VerticalAlignment="Stretch"
                      BorderBrush="#355167" BorderThickness="1" 
                      RowBackground="#F0F4F8" 
                      CanUserAddRows="False" 
                      AlternatingRowBackground="#E8EEF3">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="SpotID" Binding="{Binding SpotID}" Width="auto" />
                    <DataGridTextColumn Header="Spot Location" Binding="{Binding Location}" Width="200" />
                    <DataGridTextColumn Header="Section" Binding="{Binding Section}" Width="150" />
                    <DataGridTextColumn Header="Level" Binding="{Binding Level}" Width="150" />
                    <DataGridTemplateColumn Header="Action" Width="100">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Button Content="View" 
                                        Background="#355167"
                                        Foreground="white"
                                        Cursor="Hand"
                                        Click="viewBtn"
                                        Tag="{Binding}" />
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>
        </StackPanel>
    </Grid>

</UserControl>
