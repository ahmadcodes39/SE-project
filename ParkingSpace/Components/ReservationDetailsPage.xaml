<UserControl x:Class="ParkingSpace.Components.ReservationDetailsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:ParkingSpace.Components"
             mc:Ignorable="d" 
             
             xmlns:controls="clr-namespace:MahApps.Metro.Controls;assembly=MahApps.Metro" 
             
             xmlns:fa="clr-namespace:FontAwesome.WPF;assembly=FontAwesome.WPF"

             d:DesignHeight="650" d:DesignWidth="800">
    <Grid Background="#F0F4F8">
        <!-- Top Header -->
        <Border Background="#263B47" Height="60" VerticalAlignment="Top">
            <DockPanel VerticalAlignment="Center" Margin="0,-10,0,0">
                <fa:ImageAwesome Icon="InfoCircle" Width="30" Height="30"
                              Foreground="White" Margin="10,0" />
                <TextBlock Text="Reservation Detail Page" Foreground="White" FontSize="26" 
                        FontWeight="Bold" VerticalAlignment="Center" 
                        Margin="5,0" />
            </DockPanel>
        </Border>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition/>
                <ColumnDefinition/>
            </Grid.ColumnDefinitions>
        </Grid>
        <!-- Main Content -->
        <Border BorderThickness="1" BorderBrush="#355167" CornerRadius="5" Padding="10">

            <StackPanel Margin="20,80,20,20" Grid.Column="0" HorizontalAlignment="Left">
                <TextBlock Text="Reservation Details" Foreground="#355167" FontSize="24" FontWeight="Bold" Margin="0,0,0,30"/>

                <!-- Details Section -->
                <StackPanel Orientation="Vertical" Margin="0,0,0,20">
                    <StackPanel Orientation="Horizontal" Margin="0,5">
                        <TextBlock Text="Spot Location:" FontWeight="Bold" FontSize="18" />
                        <TextBlock Text="{Binding Location}" FontSize="18" Margin="20,0,0,0"/>
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" Margin="0,5">
                        <TextBlock Text="Start Time:" FontWeight="Bold" FontSize="18" />
                        <TextBlock Text="{Binding StartTime, StringFormat='MMM dd, yyyy hh:mm tt'}" 
                            FontSize="18" Margin="20,0,0,0"/>
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" Margin="0,5">
                        <TextBlock Text="End Time:" FontWeight="Bold" FontSize="18" />
                        <TextBlock Text="{Binding EndTime, StringFormat='MMM dd, yyyy hh:mm tt'}" 
                            FontSize="18" Margin="20,0,0,0"/>
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" Margin="0,5">
                        <TextBlock Text="Total Cost:" FontWeight="Bold" FontSize="18" />
                        <TextBlock Text="{Binding TotalCost, StringFormat='{}{0} PKR'}" FontSize="18" Margin="20,0,0,0"/>
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" Margin="0,5">
                        <TextBlock Text="Remaining Time:" FontWeight="Bold" FontSize="18" />
                        <TextBlock Text="{Binding RemainingTime}" FontSize="18" Margin="20,0,0,0"/>
                    </StackPanel>
                </StackPanel>


            </StackPanel>
        </Border>
        <StackPanel Margin="20,80,20,20" Grid.Column="1"
              HorizontalAlignment="Right"
              VerticalAlignment="Top">

            <StackPanel Orientation="Horizontal" Margin="0,10">
                <Label Content="Start Time:" Width="120" VerticalAlignment="Center" FontSize="14" />
                <DatePicker Name="StartDatePicker" Width="150" Margin="5" />
                <controls:TimePicker Name="StartTimePicker" Width="120" Margin="5" />
            </StackPanel>

            <StackPanel Orientation="Horizontal" Margin="0,10">
                <Label Content="End Time:" Width="120" VerticalAlignment="Center" FontSize="14" />
                <DatePicker Name="EndDatePicker" Width="150" Margin="5" />
                <controls:TimePicker Name="EndTimePicker" Width="120" Margin="5" />
            </StackPanel>

            <!-- Duration -->
            <StackPanel Orientation="Horizontal" Margin="0,10">
                <Label Content="Duration:" Width="120" VerticalAlignment="Center" FontSize="14" />
                <TextBox Name="DurationTextBox" Width="150" Height="25" Background="#F5F5F5" IsReadOnly="True" />
            </StackPanel>

            <!-- Total Cost -->
            <StackPanel Orientation="Horizontal" Margin="0,10">
                <Label Content="Total Cost:" Width="120" VerticalAlignment="Center" FontSize="14" />
                <TextBox Name="TotalCostTextBox" Width="150" Height="25" Background="#F5F5F5" IsReadOnly="True" />
            </StackPanel>

            <!-- Buttons -->
            <StackPanel Orientation="Vertical" Margin="0,70,0,0" HorizontalAlignment="Center">
                <Button Content="Calculate Fare"
                        Background="#355167"
                        Foreground="White"
                        FontSize="16"
                        Width="300"
                        FontWeight="Bold"
                        Height="40"
                        Click="CalculateFareBtn"
                        Margin="0,20,0,0"
                        HorizontalAlignment="Stretch"/>

                <Button Content="Extend Reservation"
                        Background="ForestGreen"
                        Foreground="White"
                        FontSize="16"
                        Width="300"
                        FontWeight="Bold"
                        Height="40"
                        Click="extendReservationBtn"
                        Margin="0,20,0,0"
                        HorizontalAlignment="Stretch"/>
                
                <Button Content="Back"
                        Background="black"
                        Foreground="White"
                        FontSize="16"
                        Width="300"
                        FontWeight="Bold"
                        Height="40"
                        Click="BackBtn"
                        Margin="0,20,0,0"
                        HorizontalAlignment="Stretch"/>


            </StackPanel>
           
        </StackPanel>

    </Grid>
</UserControl>
