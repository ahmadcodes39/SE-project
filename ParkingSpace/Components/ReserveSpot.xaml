<UserControl x:Class="ParkingSpace.Components.ReserveSpot"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:ParkingSpace.Components"
             xmlns:controls="clr-namespace:MahApps.Metro.Controls;assembly=MahApps.Metro"
             mc:Ignorable="d" 
             xmlns:fa="clr-namespace:FontAwesome.WPF;assembly=FontAwesome.WPF"
             d:DesignHeight="550" d:DesignWidth="800">
    <Grid Background="#F0F4F8">
        
        <!-- Top Bar -->
        <Border Background="#263B47" Height="60" VerticalAlignment="Top">
            <DockPanel VerticalAlignment="Center" Margin="0,-10,0,0">
                <fa:ImageAwesome Icon="CalendarPlusOutline" Width="30" Height="30"
                      Foreground="White" Margin="10,0" />
                <TextBlock Text="Reserve Spot" Foreground="White" FontSize="22" 
                FontWeight="Bold" VerticalAlignment="Center" 
                Margin="5,0" />
            </DockPanel>
        </Border>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition/>
            </Grid.ColumnDefinitions>
        </Grid>
        <!-- Main Content -->
        <StackPanel Margin="20,80,20,20" Grid.Column="0"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Top">
            <!-- Spot Information -->
            <StackPanel Orientation="Horizontal" Margin="0,10">
                <Label Content="Spot Info:" Width="120" 
                       VerticalAlignment="Center" FontSize="14" />
                <TextBox Name="SpotInfoTextBox" 
                         Width="300" Height="25" 
                         Background="#F5F5F5" IsReadOnly="True" />
            </StackPanel>

            <!-- Start Time -->
            <StackPanel Orientation="Horizontal" Margin="0,10">
                <Label Content="Start Time:" Width="120" VerticalAlignment="Center" FontSize="14" />
                <DatePicker Name="StartDatePicker" Width="150" Margin="5" />
                <controls:TimePicker Name="StartTimePicker" Width="120" Margin="5" />
            </StackPanel>

            <!-- End Time -->
            <StackPanel Orientation="Horizontal" Margin="0,10">
                <Label Content="End Time:" Width="120" VerticalAlignment="Center" FontSize="14" />
                <DatePicker Name="EndDatePicker" Width="150" Margin="5" />
                <controls:TimePicker Name="EndTimePicker" Width="120" Margin="5" />
            </StackPanel>

            <!-- Duration -->
            <StackPanel Orientation="Horizontal" Margin="0,10">
                <Label Content="Duration:" Width="120" VerticalAlignment="Center" FontSize="14" />
                <TextBox Name="DurationTextBox" Width="150" Height="25" Background="#F5F5F5" IsReadOnly="True" />
            </StackPanel>

            <!-- Total Cost -->
            <StackPanel Orientation="Horizontal" Margin="0,10">
                <Label Content="Total Cost:" Width="120" VerticalAlignment="Center" FontSize="14" />
                <TextBox Name="TotalCostTextBox" Width="150" Height="25" Background="#F5F5F5" IsReadOnly="True" />
            </StackPanel>

            <!-- Buttons -->
            <StackPanel Orientation="Horizontal" Margin="0,70,0,0" HorizontalAlignment="Center">
                <Button Content="Calculate Fare"
                        Click="CalculateFareBtn"
                        Width="150" Height="30" Margin="10"
                        Background="#355167" Foreground="White" FontWeight="SemiBold" />
                <Button Content="Confirm Reservation"
                        Width="150" Height="30" Margin="10"
                        Background="#4CAF50" Foreground="White"
                        Click="ConfirmReservationBtn"
                        FontWeight="SemiBold" />
                <Button Content="Reset"
                        Width="100" Height="30" Margin="10"
                        Background="#FF6F61" 
                        Foreground="White" Click="ResetBtn"
                        FontWeight="SemiBold" />
            </StackPanel>
        </StackPanel>

