<UserControl x:Class="ParkingSpace.Components.SignIn"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:ParkingSpace.Components"
             mc:Ignorable="d" 
             d:DesignHeight="750" d:DesignWidth="800">
    <Grid Background="white" HorizontalAlignment="Center" >
        <Grid.RowDefinitions>
            <RowDefinition  />
            <RowDefinition  />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" HorizontalAlignment="Center" Margin="0,0,0,0">
            <Image Source="D:\University\Software Engineering\Se Project\ParkingSpace\projectImages\logo1.jpg"
            Width="200" Height="200" Stretch="Uniform" />
            <Label Content="Sign In to Account"
            FontSize="28" FontWeight="SemiBold" Foreground="#063970"
            HorizontalContentAlignment="Center" Margin="0,0,0,0" />
        </StackPanel>

        <StackPanel Grid.Row="1" HorizontalAlignment="Center" Margin="0,-70,0,0" Width="300">

            <StackPanel Margin="0,0,0,15">
                <TextBlock Text="Email" FontSize="16" FontWeight="Medium" Foreground="Black" />
                <TextBox Margin="0,5,0,0" Background="White" BorderBrush="Gray" BorderThickness="1"
                   Height="35" FontSize="14" Padding="5" 
                   Name="email_txt"/>
            </StackPanel>
            

            <StackPanel Margin="0,0,0,15">
                <TextBlock Text="Password" FontSize="16" FontWeight="Medium" Foreground="Black" />
                <PasswordBox Margin="0,5,0,0" Background="White" BorderBrush="Gray" BorderThickness="1"
                        Height="35" FontSize="14" Padding="5" 
                        Name="pass_txt"/>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,0,0,15">
                    <TextBlock Text="Forgot Password?" FontSize="14" Foreground="#0645AD"
                               Cursor="Hand" TextDecorations="Underline" 
                               Margin="0,0,10,0" MouseDown="forgotPasswordLable"/>
                </StackPanel>
            </StackPanel>


            <Button Content="Sign In"
                    Height="45" FontSize="16" Margin="0,10,0,0"
                    Background="#063970" Foreground="White"
                    BorderBrush="Transparent" Click="LoginBtn" />
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,20,0,0">
                <TextBlock Text="Don't have an account?" FontSize="14" />
                <TextBlock Text="Sign Up" FontSize="14" Foreground="#0645AD"
               Cursor="Hand" TextDecorations="Underline"
               Margin="5,0,0,0"  MouseDown="NewAccount"/>
            </StackPanel>
        </StackPanel>
    </Grid>

</UserControl>
