<UserControl x:Class="ParkingSpace.Components.SuccessPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:ParkingSpace.Components"
             mc:Ignorable="d" 
             xmlns:fa="clr-namespace:FontAwesome.WPF;assembly=FontAwesome.WPF"
             d:DesignHeight="450" d:DesignWidth="800">
    <Grid>
        <!-- Background Layout -->
        <Border Background="#E0F7FA" Margin="10">
            <StackPanel VerticalAlignment="Top" Margin="0,70,0,0"  HorizontalAlignment="Center" >
                <!-- Success Message -->
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                    
                    <TextBlock Text="Payment Successful!" 
                               FontSize="24" 
                               Margin="0,0,20,0"
                               FontWeight="Bold" 
                               Foreground="Green" 
                               HorizontalAlignment="Center" />
                    <fa:ImageAwesome Icon="CheckCircleOutline" Width="30" Height="30"
                                     Foreground="Green"/>
                </StackPanel>

                <!-- Description -->
                <TextBlock Name="message_txt" 
                           FontSize="16" 
                           Margin="0,10,0,20"
                           Foreground="Black" 
                           HorizontalAlignment="Center" 
                           TextWrapping="Wrap" />

                <!-- Back Button -->
                <Button Content="Back to My Reservations" 
                        Width="200" 
                        Height="40" 
                        HorizontalAlignment="Center" 
                        VerticalAlignment="Center" 
                        Background="#4CAF50" 
                        Foreground="White" 
                        FontWeight="Bold" 
                        Click="myReservationBtn"/>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
