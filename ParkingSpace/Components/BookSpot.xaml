<UserControl x:Class="ParkingSpace.Components.BookSpot"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:ParkingSpace.Components"
             mc:Ignorable="d" 
             xmlns:fa="clr-namespace:FontAwesome.WPF;assembly=FontAwesome.WPF"
             d:DesignHeight="750" d:DesignWidth="800">
    <Grid Background="#F0F4F8">
        <Border Background="#263B47" Height="60" VerticalAlignment="Top">
            <DockPanel VerticalAlignment="Center" Margin="0,-10,0,0">
                <fa:ImageAwesome Icon="MapMarker" Width="30" Height="30"
                                Foreground="White" Margin="10,0" />
                <TextBlock Text="Schedule Spot" Foreground="White" FontSize="22" 
                           FontWeight="Bold" VerticalAlignment="Center" Margin="5,0" />
            </DockPanel>
        </Border>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition IsEnabled="{Binding IsDataGrid}"/>
                <RowDefinition/>
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="1" Margin="0,0,20,0">
                <TextBlock FontSize="24" FontWeight="Bold" Name="SpotTitle"
                           Foreground="#355167" Margin="0,03,0,20" HorizontalAlignment="Center" />

                <Border BorderThickness="1" BorderBrush="#355167" CornerRadius="5" Padding="10" Width="500">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,0">
                            <TextBlock Text="Spot Location:" FontWeight="Bold" Width="150" />
                            <TextBlock Text="{Binding Location}" />
                        </StackPanel>

                        <StackPanel Orientation="Horizontal" Margin="0,5">
                            <TextBlock Text="Section:" FontWeight="Bold" Width="150" />
                            <TextBlock Text="{Binding Section}" />
                        </StackPanel>

                        <StackPanel Orientation="Horizontal" Margin="0,5">
                            <TextBlock Text="Level:" FontWeight="Bold" Width="150" />
                            <TextBlock Text="{Binding Level}" />
                        </StackPanel>
                    </StackPanel>
                </Border>

                <Button Content="Reserve"
                        Background="#355167"
                        Foreground="White"
                        FontSize="16"
                        Width="500"
                        FontWeight="Bold"
                        Height="40"
                        Click="reserveBtn"
                        Margin="0,20,0,0"
                        HorizontalAlignment="Stretch"/>
                <Button Background="DarkSeaGreen"
                        Foreground="White"
                        FontSize="16"
                        Width="500"
                        FontWeight="Bold"
                        Height="40"
                        Click="RefreshBtn_Click"
                        Margin="0,4,0,0"
                        HorizontalAlignment="Stretch">
                    <Button.ContentTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                <fa:ImageAwesome Icon="Refresh" Foreground="black" Width="20" Height="20" Margin="0,0,10,0" />
                                <TextBlock Text="Refresh" VerticalAlignment="Center" Foreground="Black"/>
                            </StackPanel>
                        </DataTemplate>
                    </Button.ContentTemplate>
                </Button>

                <Button Content="Back"
                        Click="BackBtn"
                        Background="Black"
                        Foreground="White"
                        FontSize="16"
                        Width="500"
                        FontWeight="Bold"
                        Height="40"
                        Margin="0,4,0,0"
                        HorizontalAlignment="Stretch"/>

            </StackPanel>

            <DataGrid Grid.Row="0" Margin="10,70,20,0" 
                      RowHeight="30"  Name="dataGrid" 
                      Visibility="{Binding IsDataGrid}"
                      BorderBrush="#355167" BorderThickness="1" 
                      RowBackground="#F0F4F8" 
                      CanUserAddRows="False" 
                      AlternatingRowBackground="#E8EEF3"
                      AutoGenerateColumns="False">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="User Name" Binding="{Binding UserName}" Width="*"/>
                    <DataGridTextColumn Header="Spot Location" Binding="{Binding Location}" Width="*"/>
                    <DataGridTextColumn Header="Start Time"  Binding="{Binding StartTime, StringFormat='MMM dd, yyyy hh:mm tt'}" Width="*" />
                    <DataGridTextColumn Header="End Time" Binding="{Binding EndTime, StringFormat='MMM dd, yyyy hh:mm tt'}" Width="*" />
                    <DataGridTextColumn Header="Total Cost" Binding="{Binding TotalCost, StringFormat='{}{0} PKR'}" Width="*" />
                    <DataGridTextColumn Header="Status" Binding="{Binding SpotStatus}" Width="*"/>
                </DataGrid.Columns>
            </DataGrid>
        </Grid>
    </Grid>
</UserControl>
