<UserControl x:Class="ParkingSpace.Components.HelpInfo"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:ParkingSpace.Components"
             mc:Ignorable="d" 
             xmlns:fa="clr-namespace:FontAwesome.WPF;assembly=FontAwesome.WPF"
             d:DesignHeight="450" d:DesignWidth="800">
    <Grid Background="#F0F4F8">
        <Border Background="#263B47" Height="60" VerticalAlignment="Top">
            <DockPanel VerticalAlignment="Center" Margin="0,-10,0,0">
                <fa:ImageAwesome Icon="QuestionCircleOutline" Width="30" Height="30"
                      Foreground="White" Margin="10,0" />
                <TextBlock Text="Help Info" Foreground="White" FontSize="22" 
                FontWeight="Bold" VerticalAlignment="Center" 
                Margin="5,0" />
            </DockPanel>
        </Border>

        <!-- Help Information Content -->
        <ScrollViewer Margin="20,80,20,20">
            <StackPanel Orientation="Vertical">
                <!-- Introduction -->
                <TextBlock Text="Welcome to the Parking Management System!" 
                           FontSize="20" FontWeight="Bold" Foreground="#355167" />
                <TextBlock Text="This guide will help you understand how to use the system effectively." 
                           FontSize="16" Foreground="#444" TextWrapping="Wrap"/>

                <!-- Step 1: Check Availability -->
                <StackPanel Orientation="Vertical"  >
                    <TextBlock Text="1.Sign In to Account" FontSize="18" FontWeight="Bold" Foreground="#355167" />
                    <TextBlock Text="First you have to SignIn to use the System, if you don't have account you can create a New Account." 
                               FontSize="16" Foreground="#444" TextWrapping="Wrap"/>
                    <TextBlock Text="You can select any parking spot to view its detailed schedule and location." 
                               FontSize="16" Foreground="#444" TextWrapping="Wrap"/>
                </StackPanel>
                <StackPanel Orientation="Vertical"  >
                    <TextBlock Text="2. Check Availability" FontSize="18" FontWeight="Bold" Foreground="#355167" />
                    <TextBlock Text="Navigate to the 'Check Availability' section to view a list of all parking spots." 
                                FontSize="16" Foreground="#444" TextWrapping="Wrap"/>
                    <TextBlock Text="You can select any parking spot to view its detailed schedule and location." 
                                 FontSize="16" Foreground="#444" TextWrapping="Wrap"/>
                </StackPanel>

                <!-- Step 2: Reserve a Spot -->
                <StackPanel Orientation="Vertical"  >
                    <TextBlock Text="3. Reserve a Spot" FontSize="18" FontWeight="Bold" Foreground="#355167" />
                    <TextBlock Text="After selecting a parking spot, you will see buttons for reserving the spot or going back." 
                               FontSize="16" Foreground="#444" TextWrapping="Wrap"/>
                    <TextBlock Text="Click the 'Reserve' button to navigate to the reservation page, where you can specify the time slot you want." 
                               FontSize="16" Foreground="#444" TextWrapping="Wrap"/>
                </StackPanel>

                <!-- Step 3: Calculate Fare -->
                <StackPanel Orientation="Vertical"  >
                    <TextBlock Text="4. Calculate Fare" FontSize="18" FontWeight="Bold" Foreground="#355167" />
                    <TextBlock Text="Before confirming your reservation, use the 'Calculate Fare' button to view the cost based on your selected time." 
                               FontSize="16" Foreground="#444" TextWrapping="Wrap"/>
                </StackPanel>

                <!-- Step 4: Payment -->
                <StackPanel Orientation="Vertical"  >
                    <TextBlock Text="5. Payment" FontSize="18" FontWeight="Bold" Foreground="#355167" />
                    <TextBlock Text="On the payment page, review all reservation details and enter your payment information." 
                               FontSize="16" Foreground="#444" TextWrapping="Wrap"/>
                    <TextBlock Text="Click the 'Pay Now' button to complete the reservation process." 
                               FontSize="16" Foreground="#444" TextWrapping="Wrap"/>
                </StackPanel>

                <!-- Step 5: View My Reservations -->
                <StackPanel Orientation="Vertical">
                    <TextBlock Text="6. View My Reservations" FontSize="18" FontWeight="Bold" Foreground="#355167" />
                    <TextBlock Text="Navigate to the 'My Reservations' section to view a list of all your current and past reservations." 
                               FontSize="16" Foreground="#444" TextWrapping="Wrap"/>
                </StackPanel>

                <!-- Closing Note -->
                <StackPanel Orientation="Vertical">
                    <TextBlock Text="If you have any further questions, feel free to contact our support team." 
                           FontSize="16" FontWeight="SemiBold" Foreground="#444" TextWrapping="Wrap" Margin="0,20,0,0"/>
                    <TextBlock Text="Contact us at support@parkingmanagement.com." 
                           FontSize="16" FontWeight="SemiBold" Foreground="Black" TextWrapping="Wrap" Margin="0,5,0,0"/>
                </StackPanel>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
