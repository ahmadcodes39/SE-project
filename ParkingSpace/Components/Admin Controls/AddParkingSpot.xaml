<UserControl x:Class="ParkingSpace.Components.Admin_Controls.AddParkingSpot"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             mc:Ignorable="d" 
             xmlns:fa="clr-namespace:FontAwesome.WPF;assembly=FontAwesome.WPF"
             d:DesignHeight="450" d:DesignWidth="800">
    <Grid Background="#F0F4F8">
        <Border Background="#263B47" Height="60" VerticalAlignment="Top">
            <DockPanel VerticalAlignment="Center" Margin="0,-10,0,0">
                <fa:ImageAwesome Icon="PlusSquareOutline" Width="30" Height="30"
              Foreground="White" Margin="10,0" />

                <TextBlock Text="Add New Parking Spot" Foreground="White" FontSize="22" 
                           FontWeight="Bold" VerticalAlignment="Center" Margin="15,0" />
            </DockPanel>
        </Border>

        <StackPanel Width="400" Margin="0,80,0,0" HorizontalAlignment="Center">
            <TextBlock Text="Location:" FontSize="16" FontWeight="SemiBold" Margin="0,10,0,5"/>
            <TextBox Name="LocationInput" Width="400" Height="35" FontSize="14"
                     Background="White" BorderBrush="#C4C4C4" Padding="5" />

            <TextBlock Text="Section:" FontSize="16" FontWeight="SemiBold" Margin="0,20,0,5"/>
            <TextBox Name="SectionInput" Width="400" Height="35" FontSize="14"
                     Background="White" BorderBrush="#C4C4C4" Padding="5" />

            <TextBlock Text="Level:" FontSize="16" FontWeight="SemiBold" Margin="0,20,0,5"/>
            <TextBox Name="LevelInput" Width="400" Height="35" FontSize="14"
                     Background="White" BorderBrush="#C4C4C4" Padding="5" />

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,30,0,0">
                <Button Content="Save" Width="120" Height="40" Background="#355167" 
                        Foreground="White" FontSize="16" FontWeight="Bold" 
                        Margin="10,0" Click="saveBtn" />
                <Button Content="Cancel" Width="120" Height="40" Background="#D9534F" 
                        Foreground="White" FontSize="16" FontWeight="Bold" 
                        Margin="10,0" Click="cancelBtn" />
            </StackPanel>
        </StackPanel>
    </Grid>
</UserControl>
