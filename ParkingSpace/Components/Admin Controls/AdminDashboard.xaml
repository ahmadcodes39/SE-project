<UserControl x:Class="ParkingSpace.Components.Admin_Controls.AdminDashboard"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:ParkingSpace.Components.Admin_Controls"
             mc:Ignorable="d" 
             xmlns:fa="clr-namespace:FontAwesome.WPF;assembly=FontAwesome.WPF"
             d:DesignHeight="750" d:DesignWidth="800">
    <Grid Background="White">
        <!-- Top Bar -->
        <Border Background="#263B47" Height="60" VerticalAlignment="Top">
            <DockPanel VerticalAlignment="Center" Margin="0,-10,0,0">
                <fa:ImageAwesome Icon="Dashboard" Width="30" Height="30"
                              Foreground="White" Margin="10,0" />
                <TextBlock Text="Dashboard" Foreground="White" FontSize="22" 
                        FontWeight="Bold" VerticalAlignment="Center" 
                        Margin="5,0" />
            </DockPanel>
        </Border>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,70,0,0">
            <TextBlock Text="Seamless Parking Management for Every Space"
                       VerticalAlignment="Center"
                       FontSize="28" FontWeight="Bold" Foreground="#263B47" Margin="0,0,10,0"/>
            <fa:ImageAwesome Icon="Road"
                             Width="30" Height="30" 
                             Foreground="Black"
                             VerticalAlignment="Center"/>
        </StackPanel>


        <UniformGrid Rows="1" Columns="3" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="20,0,20,20">
            <!-- Card 1 -->
            <Border BorderBrush="#1E3A8A" CornerRadius="10" 
                    BorderThickness="2" 
                    Background="#E0F2FE" 
                    Padding="10" Margin="10"
                    Width="250">
                <StackPanel HorizontalAlignment="Center" 
                            VerticalAlignment="Center"
                            Width="250">
                    <fa:ImageAwesome Icon="UserCircleOutline" Width="40" Height="40" Foreground="#1E3A8A" Margin="0,10"/>
                    <TextBlock Text="Total Users" FontSize="17" FontWeight="Bold" Foreground="#1E3A8A" TextAlignment="Center" Margin="0,10"/>
                    <TextBlock Text="{Binding TotalUsers}" FontSize="24" FontWeight="Bold" Foreground="#1E3A8A" TextAlignment="Center"/>
                </StackPanel>
            </Border>

            <!-- Card 2 -->
            <Border BorderBrush="#7B61FF" CornerRadius="10" BorderThickness="2" Background="#EAE2FF" Padding="10" Margin="10">
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                    <fa:ImageAwesome Icon="Automobile" Width="40" Height="40" Foreground="#7B61FF" Margin="0,10"/>
                    <TextBlock Text="Parking Spots" FontSize="17" FontWeight="Bold" Foreground="#7B61FF" TextAlignment="Center" Margin="0,10"/>
                    <TextBlock Text="{Binding TotalSpots}" FontSize="24" FontWeight="Bold" Foreground="#7B61FF" TextAlignment="Center"/>
                </StackPanel>
            </Border>
            <!-- Card 3 -->
            <Border BorderBrush="#FB923C" CornerRadius="10" BorderThickness="2" Background="#FFEDD5" Padding="10" Margin="10">
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                    <fa:ImageAwesome Icon="CircleOutlineNotch" Width="40" Height="40" Foreground="#FB923C" Margin="0,10"/>
                    <TextBlock Text="Free Spots" FontSize="17" FontWeight="Bold" Foreground="#FB923C" TextAlignment="Center" Margin="0,10"/>
                    <TextBlock Text="{Binding FreeSpots}" FontSize="24" FontWeight="Bold" Foreground="#FB923C" TextAlignment="Center"/>
                </StackPanel>
            </Border>
            <!-- Card 4 -->
            <Border BorderBrush="#6B21A8" CornerRadius="10" BorderThickness="2" Background="#F3E8FF" Padding="10" Margin="10">
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                    <fa:ImageAwesome Icon="Lock" Width="40" Height="40" Foreground="#6B21A8" Margin="0,10"/>
                    <TextBlock Text="Reserved Spot" FontSize="17" FontWeight="Bold" Foreground="#6B21A8" TextAlignment="Center" Margin="0,10"/>
                    <TextBlock Text="{Binding ReservedSpots}" FontSize="24" FontWeight="Bold" Foreground="#6B21A8" TextAlignment="Center"/>
                </StackPanel>
            </Border>


            <!-- Card 5 -->
            <Border BorderBrush="#16A34A" CornerRadius="10" BorderThickness="2" Background="#D1FAE5" Padding="10" Margin="10">
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                    <fa:ImageAwesome Icon="CheckCircleOutline" Width="40" Height="40" Foreground="#16A34A" Margin="0,10"/>
                    <TextBlock Text="Complete Reservations" FontSize="17" FontWeight="Bold" Foreground="#16A34A" TextAlignment="Center" Margin="0,10"/>
                    <TextBlock Text="{Binding CompleteReservations}" FontSize="24" FontWeight="Bold" Foreground="#16A34A" TextAlignment="Center"/>
                </StackPanel>
            </Border>
             <!-- Card 6 -->
            <Border BorderBrush="#DC2626" CornerRadius="10" BorderThickness="2" Background="#FECACA" Padding="10" Margin="10">
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                    <fa:ImageAwesome Icon="TrashOutline" Width="40" Height="40" Foreground="#DC2626" Margin="0,10"/>
                    <TextBlock Text="Cancelled Reservations" FontSize="17" FontWeight="Bold" Foreground="#DC2626" TextAlignment="Center" Margin="0,10"/>
                    <TextBlock Text="{Binding CancelReservation}" FontSize="24" FontWeight="Bold" Foreground="#DC2626" TextAlignment="Center"/>
                </StackPanel>
            </Border>
            
        </UniformGrid>
    </Grid>
</UserControl>
