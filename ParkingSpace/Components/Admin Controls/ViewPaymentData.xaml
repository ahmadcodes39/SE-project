<UserControl x:Class="ParkingSpace.Components.Admin_Controls.ViewPaymentData"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:ParkingSpace.Components.Admin_Controls"
             mc:Ignorable="d" 
             xmlns:fa="clr-namespace:FontAwesome.WPF;assembly=FontAwesome.WPF"
             d:DesignHeight="450" d:DesignWidth="800">
    <Grid Background="White">

        <!-- Header Section -->
        <Border Background="#263B47" Height="60" VerticalAlignment="Top">
            <DockPanel VerticalAlignment="Center" Margin="0,-10,0,0">
                <fa:ImageAwesome Icon="Diamond" Width="30" Height="30"
                                 Foreground="White" Margin="10,0" />
                <TextBlock Text="Payments" Foreground="White" FontSize="22" 
                           FontWeight="Bold" VerticalAlignment="Center" 
                           Margin="5,0" />
            </DockPanel>
        </Border>

        <!-- Filters and DataGrid -->
        <StackPanel Margin="10,70,10,10">
            <!-- Filters Section -->
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                <!-- Spot Location Filter -->
                <StackPanel Margin="5">
                    <Label Content="Spot Location" HorizontalAlignment="Center"/>
                    <TextBox Name="SpotLocationFilter"
                             Width="150" Margin="5" />
                </StackPanel>
                <!-- Status Filter -->
                <StackPanel Margin="5">
                    <Label Content="Status" HorizontalAlignment="Center"/>
                    <ComboBox Name="StatusComboBox" Width="150" Height="25"
                              HorizontalAlignment="Center" VerticalAlignment="Center">
                        <ComboBoxItem Content="All" IsSelected="True" />
                        <ComboBoxItem Content="Active" />
                        <ComboBoxItem Content="Complete" />
                        <ComboBoxItem Content="Cancel" />
                    </ComboBox>
                </StackPanel>
            </StackPanel>

            <!-- DataGrid for Displaying Payment Data -->
            <DataGrid Name="paymentData" Height="400" AutoGenerateColumns="False"
                      HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                      BorderBrush="#355167" BorderThickness="1" 
                      RowBackground="#F0F4F8" AlternatingRowBackground="#E8EEF3">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="User Name" Binding="{Binding UserName}" Width="*" />
                    <DataGridTextColumn Header="Spot Location" Binding="{Binding Location}" Width="*" />
                    <DataGridTextColumn Header="Start Time" Binding="{Binding StartTime}" Width="*" />
                    <DataGridTextColumn Header="End Time" Binding="{Binding EndTime}" Width="*" />
                    <DataGridTextColumn Header="Total Cost" Binding="{Binding TotalCost}" Width="*" />
                    <DataGridTextColumn Header="Spot Status" Binding="{Binding ReservationStatus}" Width="*" />
                </DataGrid.Columns>
            </DataGrid>
        </StackPanel>
    </Grid>
</UserControl>
