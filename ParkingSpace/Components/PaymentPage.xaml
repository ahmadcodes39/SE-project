<UserControl x:Class="ParkingSpace.Components.PaymentPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             mc:Ignorable="d" 
             xmlns:fa="clr-namespace:FontAwesome.WPF;assembly=FontAwesome.WPF"
             d:DesignHeight="450" d:DesignWidth="800">
    <Grid Background="#F0F4F8">
        
        <!-- Main Layout -->
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>


        <!-- Top Bar -->
        <Border Background="#263B47" Height="60" VerticalAlignment="Top">
            <DockPanel VerticalAlignment="Center" Margin="0,-10,0,0">
                <fa:ImageAwesome Icon="Money" Width="30" Height="30"
                                 Foreground="White" Margin="10,0" />
                <TextBlock Text="Payment" Foreground="White" FontSize="22" 
                            FontWeight="Bold" VerticalAlignment="Center" 
                            Margin="5,0" />
            </DockPanel>
        </Border>
        <!-- Payment Form -->
        <Grid Grid.Row="1" Margin="10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2*" />
                <ColumnDefinition Width="3*" />
            </Grid.ColumnDefinitions>

            <!-- Payment Details Section -->
            <StackPanel Grid.Column="0" Margin="10">
                <TextBlock Text="Payment Details" 
                           FontSize="20" 
                           FontWeight="SemiBold" 
                           Margin="0,0,0,10" />
                <StackPanel Margin="0,5,0,0">
                    <TextBlock Text="Cardholder Name" FontWeight="Bold" />
                    <TextBox Height="30" Margin="0,5,0,15" Name="holderName_txt" />
                </StackPanel>
                <StackPanel Margin="0,5,0,0">
                    <TextBlock Text="Card Number" FontWeight="Bold" />
                    <TextBox Height="30" Margin="0,5,0,15" Name="cardNumber_txt"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,5,0,0">
                    <StackPanel Width="180">
                        <TextBlock Text="Expiry Date (MM/YY) " FontWeight="Bold" />
                        <TextBox Height="30" Name="expiryDate_txt" Margin="0,5,10,0" />
                    </StackPanel>
                    <StackPanel Width="180">
                        <TextBlock Text="CVV" FontWeight="Bold" />
                        <PasswordBox Height="30" Name="cvv_passwordBox" Margin="0,5,0,0" />
                    </StackPanel>
                </StackPanel>
            </StackPanel>

            <!-- Payment Summary Section -->
            <StackPanel Grid.Column="1" Margin="10">
                <TextBlock Text="Payment Summary" 
                           FontSize="20" 
                           FontWeight="SemiBold" 
                           Margin="0,0,0,10" />
                <Border BorderThickness="1" BorderBrush="#355167" CornerRadius="5" Padding="10">
                    <StackPanel>
                        <!-- Spot Location -->
                        <StackPanel Orientation="Horizontal" Margin="0,5">
                            <TextBlock Text="Location:" FontWeight="Bold" Width="100" />
                            <TextBlock Text="{Binding Location}" />
                        </StackPanel>

                        <!-- Duration -->
                        <StackPanel Orientation="Horizontal" Margin="0,5">
                            <TextBlock Text="Duration:" FontWeight="Bold" Width="100" />
                            <TextBlock Text="{Binding Duration}" />
                        </StackPanel>

                        <!-- Cost -->
                        <StackPanel Orientation="Horizontal" Margin="0,5">
                            <TextBlock Text="Total Cost:" FontWeight="Bold" Width="100" />
                            <TextBlock Text="{Binding TotalCost, StringFormat='{}{0} PKR'}"  FontSize="16" FontWeight="Bold" Foreground="#355167" />
                        </StackPanel>

                        <!-- Total -->
                        <StackPanel Orientation="Horizontal" Margin="0,5">
                            <TextBlock Text="Start Time:" FontWeight="Bold" Width="100" />
                            <TextBlock Text="{Binding StartTime, StringFormat='MMM dd, yyyy'}" FontSize="16" FontWeight="Bold" Foreground="#355167" />
                        </StackPanel>

                        <!-- End Time -->
                        <StackPanel Orientation="Horizontal" Margin="0,5">
                            <TextBlock Text="End Time:" FontWeight="Bold" Width="100" />
                            <TextBlock Text="{Binding EndTime, StringFormat='MMM dd, yyyy'}" FontSize="16" FontWeight="Bold" Foreground="#355167" />
                        </StackPanel>
                    </StackPanel>
                </Border>

                <Button Content="Pay Now" 
                        Background="#355167" 
                        Foreground="White" 
                        FontSize="16" 
                        FontWeight="Bold" 
                        Height="40" 
                        Margin="0,20,0,0"
                        Click="PayNowBtn"
                        HorizontalAlignment="Stretch" />
            </StackPanel>
        </Grid>
    </Grid>
</UserControl>
