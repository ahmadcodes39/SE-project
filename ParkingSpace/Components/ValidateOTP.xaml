<UserControl x:Class="ParkingSpace.Components.ValidateOTP"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:ParkingSpace.Components"
             mc:Ignorable="d" 
             d:DesignHeight="750" d:DesignWidth="800">
    <Grid Background="#F9F9F9" HorizontalAlignment="Center" Margin="0,30,0,0">
        <Grid.RowDefinitions>
            <RowDefinition  />
            <RowDefinition  />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" HorizontalAlignment="Center" Margin="0,0,0,0">
            <Image Source="D:\University\EAD Project Test\Project\Project Images\verifyOTP.png"
         Width="200" Height="200" Stretch="Uniform" />
            <Label Content="Verify OTP"
         FontSize="28" FontWeight="SemiBold" Foreground="#063970"
         HorizontalContentAlignment="Center" Margin="0,0,0,0" />
        </StackPanel>

        <StackPanel Grid.Row="1" HorizontalAlignment="Center" Margin="0,-70,0,0" Width="300">
            <StackPanel Margin="0,0,0,15">
                <TextBlock Text="Enter OTP" FontSize="16" FontWeight="Medium" Foreground="Black" />
                <PasswordBox Margin="0,5,0,0" Background="White" BorderBrush="Gray" BorderThickness="1"
               Height="35" FontSize="14" Padding="5" Name="OTP_txt" />
            </StackPanel>

            <Button Content="Verify"
          Height="45" FontSize="16" Margin="0,10,0,0"
          Background="#063970" Foreground="White"
          BorderBrush="Transparent" Click="Button_Click" />

        </StackPanel>
    </Grid>

</UserControl>
