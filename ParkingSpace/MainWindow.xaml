<Window x:Class="ParkingSpace.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="MainWindow" Height="450" Width="800">
    <Grid>
        <StackPanel x:Name="RoleSelectionPopup" Height="300" Width="500" Background="#355167" Visibility="Visible"
            VerticalAlignment="Center" HorizontalAlignment="Center">
            <TextBlock Text="Choose Your Role" FontSize="24" Foreground="White" FontWeight="SemiBold"
               Margin="0,100,0,10" HorizontalAlignment="Center" TextAlignment="Center"/>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,20,0,0" >
                <Button Content="Admin" Width="120" Height="45" FontSize="16"
                        Background="#355167" Foreground="White" BorderBrush="white"
                        Click="AdminSelected"
                        Margin="0,0,10,0"/>

                <Button Content="User" Width="120" Height="45" FontSize="16"
                        Background="#355167"   Foreground="White" BorderBrush="white"
                        Click="UserSelected"/>
            </StackPanel>
        </StackPanel>

        <DockPanel LastChildFill="True">
            <ContentControl x:Name="TopBarContent" DockPanel.Dock="Top" />
            <ContentControl x:Name="MainContent" />
        </DockPanel>
    </Grid>
</Window>
